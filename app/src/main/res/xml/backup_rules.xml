<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude everything from Auto Backup. Phase 2 stores JWTs in EncryptedSharedPreferences,
    which must never be restored without its Keystore key.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
